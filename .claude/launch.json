{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "micro-grid-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "micro-grid-frontend",
        "run",
        "start",
        "--",
        "--port",
        "4200"
      ],
      "port": 4200
    },
    {
      "name": "micro-grid-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd micro-grid-backend && call .\\mvnw.cmd -q -Dspring-boot.run.profiles=dev spring-boot:run"
      ],
      "port": 8080
    }
  ]
}
